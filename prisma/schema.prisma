// ANOR marketplace data model.
// Conventions:
//  - Money is stored as Int in so'm (UZS has no practical minor unit).
//  - Localized content: *Uz (Latin) and *Ru columns; Uzbek Cyrillic is derived
//    by transliteration at render time unless an explicit *Cyrl override exists.
//  - Soft delete via deletedAt where records must stay auditable.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

