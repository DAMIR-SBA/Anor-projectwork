# ─────────────────────────────────────────────────────────────────────────────
# ANOR marketplace — environment variables
# Copy to `.env` and replace every placeholder. NEVER commit real secrets.
# Values containing CHANGE_ME are rejected when NODE_ENV=production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Public base URL of the app (no trailing slash). Used for OAuth redirects, emails, OG tags, webhooks.
APP_URL="http://localhost:3000"
# Same as APP_URL, exposed to the browser (share links, Telegram Mini App).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# All business dates (deliveries, streaks, reports) are computed in this IANA time zone.
NEXT_PUBLIC_APP_TIMEZONE="Asia/Tashkent"
# Random 32+ char string. Signs cookies, derives encryption keys (webhook secrets, TOTP). Generate: openssl rand -base64 48
SESSION_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_48"
# true = show one-click demo accounts on login pages and the "reset demo data" admin button. Keep false in real production.
DEMO_MODE="true"
# Mirrors DEMO_MODE for client components (banner, demo buttons).
NEXT_PUBLIC_DEMO_MODE="true"
# debug | info | warn | error — structured JSON logs threshold.
LOG_LEVEL="info"

# ── Database (PostgreSQL 15+) ────────────────────────────────────────────────
# Runtime connection (on Supabase use the pooled "Transaction" URL, port 6543, with ?pgbouncer=true).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anor"
# Direct (non-pooled) connection used by `prisma migrate` and the seed (Supabase "Session"/direct URL, port 5432).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/anor"

# ── First SUPER_ADMIN (created by `npm run db:seed`) ────────────────────────
# Login for the owner account at the hidden /staff/login route (4-20 chars: letters, digits, underscore).
SUPER_ADMIN_LOGIN="CHANGE_ME_owner_login"
# Owner password (min 12 chars). Rotate after first login.
SUPER_ADMIN_PASSWORD="CHANGE_ME_long_owner_password"
# Owner admin access code (third factor at staff login, min 6 chars). Separate from any user PIN.
SUPER_ADMIN_ACCESS_CODE="CHANGE_ME_access_code"
# Email that receives security alerts (failed staff logins, etc.). Optional.
OWNER_ALERT_EMAIL="owner@example.com"

# ── Google login (optional; button hidden when empty) ───────────────────────
# OAuth 2.0 Client ID from Google Cloud Console (Web application).
GOOGLE_CLIENT_ID=""
# OAuth client secret. Authorized redirect URI must be {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_SECRET=""

# ── Storage for uploads (avatars, product photos, chat files) ───────────────
# local | supabase. "local" writes to STORAGE_LOCAL_DIR (not persistent on Vercel!).
STORAGE_DRIVER="local"
# Directory for the local driver; files are served via /uploads/*.
STORAGE_LOCAL_DIR="./storage/uploads"
# Supabase project URL, e.g. https://xyzcompany.supabase.co (supabase driver only).
STORAGE_SUPABASE_URL=""
# Supabase service_role key — server only, never expose to the browser (supabase driver only).
STORAGE_SUPABASE_SERVICE_KEY=""
# Public bucket name in Supabase Storage.
STORAGE_SUPABASE_BUCKET="anor"
# Max upload size in megabytes (images, files, voice messages).
STORAGE_MAX_UPLOAD_MB="10"

# ── Email ────────────────────────────────────────────────────────────────────
# console | resend | smtp. "console" prints emails to the server log; "smtp" works with Mailpit from docker-compose.
EMAIL_DRIVER="console"
# Sender shown in outgoing emails.
EMAIL_FROM="ANOR <no-reply@example.com>"
# Resend API key (resend driver only).
EMAIL_RESEND_API_KEY=""
# SMTP host/port/user/password (smtp driver only). Mailpit: localhost / 1025, no auth.
EMAIL_SMTP_HOST="localhost"
EMAIL_SMTP_PORT="1025"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""

# ── SMS (OTP codes, order updates) ──────────────────────────────────────────
# console | eskiz. "console" logs codes to the server output (and shows them in DEMO_MODE).
SMS_DRIVER="console"
# Eskiz-compatible API base URL.
SMS_ESKIZ_BASE_URL="https://notify.eskiz.uz/api"
# Eskiz account email/password used to obtain the bearer token.
SMS_ESKIZ_EMAIL=""
SMS_ESKIZ_PASSWORD=""
# Approved sender name / short number.
SMS_SENDER="4546"

# ── Rate limiting (Upstash Redis REST; in-memory fallback when empty) ───────
# REST URL of an Upstash database, or http://localhost:8079 for the serverless-redis-http container in docker-compose.
UPSTASH_REDIS_REST_URL=""
# REST token for the URL above.
UPSTASH_REDIS_REST_TOKEN=""

# ── Background jobs & realtime ───────────────────────────────────────────────
# inline | pgboss. "pgboss" queues jobs in Postgres and requires `npm run worker`; "inline" runs them in-process.
JOBS_DRIVER="inline"
# sse | poll. "sse" = Server-Sent Events (+ Postgres LISTEN/NOTIFY across instances); "poll" = client polling only (serverless).
REALTIME_DRIVER="sse"
# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token).
CRON_SECRET="CHANGE_ME_cron_secret"

# ── AI (optional; keyword/rule fallbacks are used when empty) ───────────────
# Google AI Studio key for Gemini (assistant, review summaries, category suggestions, image search).
GEMINI_API_KEY=""
# Primary model id.
GEMINI_MODEL="gemini-2.5-flash"
# Model used when the primary one fails or is rate limited.
GEMINI_FALLBACK_MODEL="gemini-2.5-flash-lite"

# ── Telegram (optional; bot features are mocked when empty) ─────────────────
# Bot token from @BotFather (buyer bot: order status, alerts, support bridge, login, Mini App).
TELEGRAM_BOT_TOKEN=""
# Bot username without @ (for the login widget and t.me links).
TELEGRAM_BOT_USERNAME="anor_demo_bot"
# Random string; Telegram sends it in X-Telegram-Bot-Api-Secret-Token for webhook verification.
TELEGRAM_WEBHOOK_SECRET="CHANGE_ME_webhook_secret"
# Separate seller bot token (new-order notifications with Confirm/Reject). Falls back to TELEGRAM_BOT_TOKEN.
TELEGRAM_SELLER_BOT_TOKEN=""
# Seller bot username without @ (for the "link Telegram" deep link in seller settings).
TELEGRAM_SELLER_BOT_USERNAME=""
# Chat id that receives owner security alerts (failed staff logins).
TELEGRAM_OWNER_CHAT_ID=""

# ── Maps (pickup points, address picker) ────────────────────────────────────
# XYZ tile URL template. Use your own tile provider in production (OSM tiles have a usage policy).
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# Attribution HTML required by the tile provider.
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
# Default map center (Tashkent).
NEXT_PUBLIC_MAP_DEFAULT_LAT="41.3111"
NEXT_PUBLIC_MAP_DEFAULT_LNG="69.2797"

# ── Web push (optional) ──────────────────────────────────────────────────────
# VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Same public key for the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# Contact for push services.
VAPID_SUBJECT="mailto:support@example.com"

# ── Observability (optional) ─────────────────────────────────────────────────
# Sentry DSN; errors are sent via the Sentry envelope API when set.
SENTRY_DSN=""
# Optional antivirus hook: uploads are POSTed here and must answer {"clean": true}. Empty = scan skipped (marked SKIPPED).
VIRUS_SCAN_WEBHOOK_URL=""
